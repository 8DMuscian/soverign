# ============================================================
# SOVEREIGN AI WORKBENCH — CONFIGURATION
# ============================================================
# Copy this file to .env and edit the values below.
#   cp .env.example .env
#
# Model configuration has moved to sovereign/models/*.yaml
# Agent configuration has moved to sovereign/agents/*.yaml
# ============================================================

# Sandbox resource limits (applied to the Docker container)
SANDBOX_IMAGE=sandbox-python:latest
SANDBOX_TIMEOUT=60
SANDBOX_MEM_LIMIT=512m

# Retry limits for the LangGraph retry loops
MAX_EXTRACT_RETRIES=3
MAX_SANDBOX_RETRIES=2
MAX_SECURITY_RETRIES=2

# Frontend
FRONTEND_PORT=8501

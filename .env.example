# ============================================================
# SOVEREIGN AI WORKBENCH — CONFIGURATION
# ============================================================
# Copy this file to .env and edit the values below.
#   cp .env.example .env
#
# Both Node 1 and Node 2 must be on the SAME ad-hoc WLAN.
# Use each machine's local IP on that network (not your router IP).
# ============================================================

# Node 1 — vLLM endpoint (the GPU laptop hosting the model)
VLLM_BASE_URL=http://192.168.1.5:8000/v1
VLLM_MODEL=Qwen2.5-coder-7B-Instruct-AWQ

# Sandbox resource limits (applied to the Docker container)
SANDBOX_TIMEOUT=60
SANDBOX_MEM_LIMIT=512m
